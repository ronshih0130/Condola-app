# Local plain-Postgres (see scripts/db-setup.sh). The password is for the demo only.
DATABASE_URL=postgres://condola:condola@127.0.0.1:5432/condola

# Local demo only. Ignored, and the server refuses to start, when NODE_ENV=production
# or CONDOLA_ENV is production, staging, or staging-real. While it is on, the authenticator
# accepts 123456 and an Admin can POST /api/demo/reset.
DEMO_MODE=true

# The Cloudflare staging Worker sets CONDOLA_ENV=staging and DEMO_MODE=false.
# See docs/STAGING.md. Do not copy this local file onto that Worker.
# CONDOLA_ENV=staging

# LINE Login is a demo sign-in for the linked member. It does not call LINE.
# Unset follows DEMO_MODE. Set false to hide the button. Set true only for a local demo.
# NODE_ENV=production or CONDOLA_ENV=production/staging/staging-real ignores the flag and
# refuses to start if it is still true.
# LINE_LOGIN_ENABLED=false

# Optional. When both are set, password checks use Supabase Auth instead of local crypt().
# Never commit real keys. Staging uses a separate Supabase project from production.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ID photos are encrypted at rest. Each value is exactly 32 bytes:
# 64 hex characters, or standard base64 that decodes to 32 bytes (44 characters with =).
# Not a passphrase. The server does not hash a set value.
#   ID_DOC_ENCRYPTION_KEY  raw AES-256-GCM key
#   ID_DOC_HMAC_KEY        raw HMAC-SHA256 key for the ID number
#   ID_DOC_SIGNING_SECRET  raw HMAC-SHA256 key for photo tokens
# Generate with: openssl rand -hex 32
# ID_DOC_ENCRYPTION_KEY is required even in demo mode. A missing or empty value
# refuses startup. ID_DOC_HMAC_KEY and ID_DOC_SIGNING_SECRET may be unset in
# demo mode (DEMO_MODE=true, and not production/staging) and then use local
# demo material. Outside demo mode all three are required.
# ID_DOC_ENCRYPTION_KEY=
# ID_DOC_HMAC_KEY=
# ID_DOC_SIGNING_SECRET=
# ID_PURGE_ENABLED is GLOBAL DB configuration, NOT an environment variable.
# platform_settings key ID_PURGE_ENABLED: JSON string "off" (default),
# "dry_run" (counts + at most one audit row), or "on" (deletes).
# Missing/invalid/read-error => OFF. No cache; see docs/DEPLOY.md.
# Owner PE; long-lived kill switch, quarterly review (PRINCIPLES section 5).
# Scheduled purge: POST /api/cron/purge-id-documents with header x-cron-secret.
# Demo mode also accepts the header value demo-cron.
# Staging and production require CRON_SECRET. The Worker cron sends it.
# CRON_SECRET=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "condola",
  "main": "./custom-worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Watermark faces are Data modules so Workers can import the bytes. A base64
  // string in the script is large enough that workerd will not start.
  "rules": [
    { "type": "Data", "globs": ["**/*.ttf"], "fallthrough": true }
  ],
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "condola"
    }
  ],
  // Depot CI deploys the staging env only. Production is manual. See docs/DEPLOY.md.
  // Secret values are not stored here. Set each name with:
  //   npx wrangler secret put <NAME> --env staging
  //   npx wrangler secret put <NAME> --env production
  "env": {
    "staging": {
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      "vars": {
        "CONDOLA_ENV": "staging",
        "CONDOLA_SITE_URL": "https://staging.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false",
        "MAIL_PROVIDER": "cloudflare"
      },
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "ID_DOC_ENCRYPTION_KEY",
          "ID_DOC_HMAC_KEY",
          "ID_DOC_SIGNING_SECRET",
          "CRON_SECRET"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-staging"
        }
      ],
      // 09:00 Asia/Taipei reminders, 03:00 Asia/Taipei ID-photo purge. Both are Workers Free cron triggers.
      "triggers": {
        "crons": ["0 1 * * *", "0 19 * * *"]
      },
      "observability": {
        "enabled": true
      }
    },
    "production": {
      "name": "condola-prod",
      "logpush": true,
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      "vars": {
        "CONDOLA_ENV": "production",
        "BRAND_V2": "true",
        "CONDOLA_SITE_URL": "https://app.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false",
        "STAGING_AUTODEPLOY": "false",
        "MAIL_PROVIDER": "cloudflare"
      },
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY",
          "ID_DOC_ENCRYPTION_KEY",
          "ID_DOC_HMAC_KEY",
          "ID_DOC_SIGNING_SECRET",
          "CRON_SECRET"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-prod"
        }
      ],
      "triggers": {
        "crons": ["0 1 * * *", "0 19 * * *"]
      },
      "routes": [
        { "pattern": "app.condola.app", "custom_domain": true }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "condola",
  "main": "./custom-worker.mjs",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "condola"
    }
  ],
  // Depot CI deploys the staging env only. Production is manual. See docs/DEPLOY.md.
  // Secret values are not stored here. Set each name with:
  //   npx wrangler secret put <NAME> --env staging
  //   npx wrangler secret put <NAME> --env production
  "env": {
    "staging": {
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      // Direct host port 5432 as condola_hyperdrive, caching disabled.
      // The connection string stays out of git. See README.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "2f14fd9785044250ba3b83fbe0025942"
        }
      ],
      "vars": {
        "CONDOLA_ENV": "staging",
        "CONDOLA_SITE_URL": "https://staging.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false",
        "MAIL_PROVIDER": "cloudflare"
      },
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "triggers": { "crons": ["0 1 * * *"] },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-staging"
        }
      ],
      "observability": {
        "enabled": true
      }
    },
    "production": {
      "name": "condola-prod",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      // TODO: replace id with the config id from `npx wrangler hyperdrive create condola-production`.
      "hyperdrive": [
        {
          "binding": "HYPERDRIVE",
          "id": "TODO_PRODUCTION_HYPERDRIVE_ID"
        }
      ],
      "vars": {
        "CONDOLA_ENV": "production",
        "CONDOLA_SITE_URL": "https://app.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false",
        "STAGING_AUTODEPLOY": "false",
        "MAIL_PROVIDER": "cloudflare"
      },
      "send_email": [{ "name": "EMAIL", "remote": true }],
      "triggers": { "crons": ["0 1 * * *"] },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-prod"
        }
      ],
      "routes": [
        { "pattern": "app.condola.app", "custom_domain": true }
      ],
      "observability": {
        "enabled": true
      }
    }
  }
}

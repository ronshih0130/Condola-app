{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "condola",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "condola"
    }
  ],
  // Depot CI deploys the staging env only. Production is manual. See docs/DEPLOY.md.
  // Secret values are not stored here. Set each name with:
  //   npx wrangler secret put <NAME> --env staging
  //   npx wrangler secret put <NAME> --env production
  "env": {
    "staging": {
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": true,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      "vars": {
        "CONDOLA_ENV": "staging",
        "CONDOLA_SITE_URL": "https://staging.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-staging"
        }
      ]
    },
    "production": {
      "name": "condola-prod",
      "compatibility_flags": ["nodejs_compat"],
      "workers_dev": false,
      "placement": {
        "mode": "targeted",
        "region": "aws:ap-northeast-1"
      },
      "vars": {
        "CONDOLA_ENV": "production",
        "CONDOLA_SITE_URL": "https://app.condola.app",
        "DEMO_MODE": "false",
        "LINE_LOGIN_ENABLED": "false",
        "STAGING_AUTODEPLOY": "false"
      },
      "secrets": {
        "required": [
          "DATABASE_URL",
          "SUPABASE_URL",
          "SUPABASE_ANON_KEY",
          "SUPABASE_SERVICE_ROLE_KEY"
        ]
      },
      "services": [
        {
          "binding": "WORKER_SELF_REFERENCE",
          "service": "condola-prod"
        }
      ],
      "routes": [
        { "pattern": "app.condola.app", "custom_domain": true }
      ]
    }
  }
}

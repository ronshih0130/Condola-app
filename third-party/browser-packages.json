    {
      "name": "@swc/helpers",
      "walk": true,
      "exclude": [],
      "why": "Explicit dependency of the Next client runtime."
    },
    {
      "name": "pdf-lib",
      "walk": true,
      "exclude": [],
      "why": "Dynamically loaded browser PDF generation."
    },
    {
      "name": "@pdf-lib/fontkit",
      "walk": true,
      "exclude": [],
      "why": "Browser PDF font embedding."
    },
    {
      "name": "heic-convert",
      "walk": true,
      "exclude": ["jpeg-js", "pngjs"],
      "why": "Browser conversion uses canvas encoders; jpeg-js and pngjs belong exclusively to formats-node.js."

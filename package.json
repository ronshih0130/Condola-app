{
  "name": "condola",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 43123 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 43123 -H 0.0.0.0",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:reset": "bash scripts/db-reset.sh",
    "db:setup": "bash scripts/db-setup.sh",
    "test:unit": "tsx --test src/server/password.test.ts src/server/lockout.test.ts src/server/perms.test.ts src/server/privacy.test.ts src/server/demo.test.ts src/server/review.test.ts",
    "test:rls": "tsx --test src/server/rls.test.ts && tsx --test src/server/auth.integration.test.ts",
    "cf:build": "opennextjs-cloudflare build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "15.5.28",
    "pg": "^8.23.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "wrangler": "^4.151.2"
  }
}
